DTEND;VALUE=DATE:20270126
RRULE:FREQ=YEARLY
SUMMARY:论语 2.16 攻乎异端
DESCRIPTION:论语 2.16：子曰：攻乎异端，斯害也已。\nhttps://
 yikonglu.com/lunyu/wei-zheng/16.html
URL:https://yikonglu.com/lunyu/wei-zheng/16.html
TRANSP:TRANSPARENT
END:VEVENT
